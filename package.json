{
  "name": "bunrui-paper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "本の感想用ページの表示ツール",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "lint": "biome check .",
    "format": "biome check --write .",
    "unit": "vitest run",
    "verify": "node scripts/verify-build.mjs",
    "test": "npm run lint && npm run unit && npm run build && npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CALIL/bunrui-paper.git"
  },
  "author": "CALIL Inc",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CALIL/bunrui-paper/issues"
  },
  "homepage": "https://github.com/CALIL/bunrui-paper#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "sass": "^1.102.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource/kosugi-maru": "^5.3.0",
    "jsbarcode": "^3.12.3",
    "paper-css": "^0.4.1"
  }
}
